<!-- مودال الوثائق -->
<div id="documentsModal" class="modal-overlay">
  <div class="modal-box">
    <h2><i class="fas fa-file-alt"></i> وثائق السائق</h2>
    <div class="sub" id="docDriverName">اسم السائق: ---</div>
    <div id="documentsList"></div>
    <button class="modal-close-btn" onclick="closeDocuments()"><i class="fas fa-times"></i> إغلاق</button>
  </div>
</div>

<!-- مودال تقرير طلبات السائق -->
<div id="reportModal" class="modal-overlay">
  <div class="modal-box">
    <h2><i class="fas fa-chart-line"></i> تقرير طلبات السائق</h2>
    <div class="sub" id="reportDriverName">اسم السائق: ---</div>
    <div id="reportContent"></div>
    <button class="modal-close-btn" onclick="closeReport()"><i class="fas fa-times"></i> إغلاق</button>
  </div>
</div>

<!-- مودال تقرير طلبات المستخدم -->
<div id="userOrdersModal" class="modal-overlay">
  <div class="modal-box">
    <h2><i class="fas fa-list-ul"></i> تقرير طلبات المستخدم</h2>
    <div class="sub" id="userOrdersName">اسم المستخدم: ---</div>
    <div id="userOrdersContent"></div>
    <button class="modal-close-btn" onclick="closeUserOrders()"><i class="fas fa-times"></i> إغلاق</button>
  </div>
</div>

<!-- مودال تفاصيل الإبلاغ -->
<div id="reportDetailModal" class="modal-overlay">
  <div class="modal-box">
    <h2><i class="fas fa-file-alt"></i> تفاصيل الإبلاغ</h2>
    <div class="sub" id="reportDetailTitle">عنوان الإبلاغ</div>
    <div id="reportDetailContent"></div>
    <div id="replySection" style="margin-top:20px; border-top:1px solid #2a3546; padding-top:15px;">
      <h4 style="color:#b0c0d4; margin-bottom:10px;"><i class="fas fa-comments"></i> المحادثة</h4>
      <div id="chatThread" class="chat-thread"></div>
      <div class="reply-input-area">
        <textarea id="replyInput" placeholder="اكتب ردك هنا..."></textarea>
        <button onclick="sendReply()"><i class="fas fa-paper-plane"></i> إرسال</button>
      </div>
    </div>
    <button class="modal-close-btn" onclick="closeReportDetail()"><i class="fas fa-times"></i> إغلاق</button>
  </div>
</div>

<!-- مودال القائمة -->
<div id="listModal" class="modal-overlay">
  <div class="modal-box">
    <h2><i class="fas fa-list-ul"></i> <span id="listModalTitle">القائمة</span></h2>
    <div class="sub" id="listModalSub">تفاصيل الأعضاء</div>
    <div id="listModalContent"></div>
    <button class="modal-close-btn" onclick="closeListModal()"><i class="fas fa-times"></i> إغلاق</button>
  </div>
</div>

<!-- مودال إعادة تعيين كلمة المرور -->
<div id="resetPasswordModal" class="modal-overlay password-modal">
  <div class="modal-box">
    <h2><i class="fas fa-key"></i> إعادة تعيين كلمة المرور</h2>
    <div class="sub">قم بتغيير كلمة المرور الخاصة بحساب المدير.</div>
    <input type="password" id="currentPassword" placeholder="كلمة المرور الحالية">
    <input type="password" id="newPassword" placeholder="كلمة المرور الجديدة">
    <input type="password" id="confirmPassword" placeholder="تأكيد كلمة المرور الجديدة">
    <button class="btn-submit" onclick="handleResetPassword()"><i class="fas fa-save"></i> حفظ التغييرات</button>
    <div id="resetMsg" class="msg"></div>
    <button class="modal-close-btn" onclick="closeResetPassword()" style="margin-top:15px;"><i class="fas fa-times"></i> إلغاء</button>
  </div>
</div>

<!-- مودال الشات -->
<div id="chatModal" class="modal-overlay chat-modal">
  <div class="modal-box">
    <h2><i class="fas fa-comment-dots"></i> <span id="chatTitle">المحادثة</span></h2>
    <div class="sub" id="chatSub">مراسلة الطرف الآخر</div>
    <div id="chatMessages" class="chat-messages"></div>
    <div class="chat-input-area">
      <input type="text" id="chatInput" placeholder="اكتب رسالتك...">
      <button onclick="sendChatMessage()"><i class="fas fa-paper-plane"></i> إرسال</button>
    </div>
    <button class="modal-close-btn" onclick="closeChat()"><i class="fas fa-times"></i> إغلاق</button>
  </div>
</div>
