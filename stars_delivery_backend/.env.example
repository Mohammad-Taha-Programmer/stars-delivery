PORT=3000
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname
# Generate a cryptographically random value with at least 32 characters.
JWT_SECRET=
# Generate a different cryptographically random value with at least 32 characters.
SESSION_SECRET=

# Optional comma-separated browser origins allowed to call the API cross-origin.
# Leave empty for same-origin browser access plus native/mobile clients.
# Example: https://admin.example.com,https://app.example.com
CORS_ALLOWED_ORIGINS=
IMGBB_API_KEY=your_imgbb_api_key_here

# Used only by: npm run admin:bootstrap
ADMIN_EMAIL=administrator@example.com
ADMIN_FULL_NAME=Administrator
# Supply this only when explicitly running the bootstrap command; minimum 12 characters.
ADMIN_PASSWORD=
