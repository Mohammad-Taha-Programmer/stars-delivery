[Unit]
Description=Stars Delivery Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

User=stars-delivery
Group=stars-delivery

WorkingDirectory=/opt/stars-delivery/current/stars_delivery_backend

EnvironmentFile=/etc/stars-delivery/stars-delivery.env

ExecStart=/usr/bin/node src/index.js

Restart=on-failure
RestartSec=5s

KillSignal=SIGTERM
TimeoutStopSec=30s

UMask=0077

NoNewPrivileges=true
PrivateTmp=true

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
