# ============================================================
# Stars Delivery production environment TEMPLATE.
#
# Copy to:
#   /etc/stars-delivery/stars-delivery.env
#
# Never commit the real environment file.
# Replace every required blank value before service start.
# ============================================================

NODE_ENV=production
PORT=3000

# MongoDB
MONGODB_URI=

# Authentication secrets.
# Each must be a different cryptographically random value
# with at least 32 characters.
JWT_SECRET=
SESSION_SECRET=

# Native/mobile applications are not governed by browser
# CORS. Add browser origins only if a separate browser
# frontend requires cross-origin API access.
CORS_ALLOWED_ORIGINS=

# Existing image-host integration.
IMGBB_API_KEY=

# Password-recovery signing secret.
# Must differ from JWT_SECRET and SESSION_SECRET.
PASSWORD_RECOVERY_SECRET=

# Recovery email transport.
#
# Typical examples:
#   SMTP_PORT=465 + SMTP_SECURE=true
#   SMTP_PORT=587 + SMTP_SECURE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false

# Both supplied or both omitted for trusted relay.
SMTP_USER=
SMTP_PASS=

SMTP_FROM=

# Private persistent provider-document storage.
# Must remain outside public uploads and source tree.
PROVIDER_DOCUMENTS_DIR=/var/lib/stars-delivery/provider-documents
